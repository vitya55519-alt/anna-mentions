# --- Что включено -----------------------------------------------------------
# Список сетей через запятую. Сейчас основной режим — Telegram:
# бот читает чаты, куда его добавили, без MTProto-сессии.
# Когда появятся токены, достаточно написать: telegram,vk,ok
ENABLED_NETWORKS=telegram

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=
# Публичный HTTPS-адрес этого сервиса на Railway (он же URL Mini App).
# Можно не задавать: Railway сам выставляет RAILWAY_PUBLIC_DOMAIN, адрес соберётся из него.
WEBAPP_URL=
RAILWAY_PUBLIC_DOMAIN=
# Читать сообщения из чатов, куда добавлен бот
TG_LIVE_INGEST=true

# --- База данных ------------------------------------------------------------
# Railway подставляет DATABASE_URL автоматически при линковке Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comments

# --- ВКонтакте --------------------------------------------------------------
# Адаптер остаётся в коде и включается строкой ENABLED_NETWORKS=telegram,vk
# Токен пользователя с правами wall, groups (или сервисный токен сообщества)
VK_TOKEN=
VK_USER_TOKEN=
VK_API_VERSION=5.199

# --- Одноклассники ----------------------------------------------------------
OK_APP_KEY=
OK_APP_SECRET=
OK_ACCESS_TOKEN=
OK_ADAPTER_ENABLED=false

# --- Telegram-источники (MTProto) -------------------------------------------
# Аккаунты-сборщики: каждый видит свои группы, вместе дают широкий охват.
# Строки сессий получаются командой: python scripts/tg_session.py
# Без них бот всё равно читает чаты, куда его добавили вручную.
TG_API_ID=
TG_API_HASH=
TG_SESSION_1=
TG_SESSION_2=
TG_SESSION_3=
# Старое имя единственной сессии — тоже подхватывается
TG_SESSION_STRING=

# --- Сканирование групп аккаунтами ------------------------------------------
TG_SCAN_ENABLED=true
# Сколько диалогов брать у каждого аккаунта (по активности)
TG_SCAN_DIALOGS_LIMIT=100
# Сколько последних сообщений читать из группы за проход
TG_SCAN_MESSAGES_PER_DIALOG=120
# Сканировать и каналы, а не только группы
TG_SCAN_CHANNELS=true
# Кому принадлежат найденные группы (0 — первый, кто написал боту)
OWNER_TELEGRAM_ID=0
# Пауза между сообщениями — защита от блокировки Telegram
TG_SCAN_PAUSE_SECONDS=0.3
# Как часто перечитывать список групп
TG_SCAN_INTERVAL_MINUTES=60

# --- Instagram --------------------------------------------------------------
# Как и ВК/ОК, выключен в интерфейсе, но код адаптера на месте.
INSTAGRAM_ENABLED=false
IG_ACCESS_TOKEN=
IG_BUSINESS_ID=

# --- Проверка по статьям УК РФ ----------------------------------------------
# rubrics/uk_rf.json — статьи УК; rubrics/default.json — пример старого формата.
RUBRICS_FILE=uk_rf.json
# Любой OpenAI-совместимый эндпоинт. Для Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_MIN_SCORE=0.45
ANALYZE_ON_INGEST=true

# --- Прочее -----------------------------------------------------------------
# Только для локальной отладки: отключает проверку initData
DEV_MODE=false
# web | worker — какой процесс запускать в контейнере
APP_ROLE=web
DEFAULT_CRAWL_INTERVAL_MINUTES=60
WORKER_POLL_SECONDS=20
