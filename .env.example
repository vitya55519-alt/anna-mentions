# --- Что включено -----------------------------------------------------------
# Список сетей через запятую. Сейчас основной режим — Telegram:
# бот читает чаты, куда его добавили, без MTProto-сессии.
# Когда появятся токены, достаточно написать: telegram,vk,ok
ENABLED_NETWORKS=telegram

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=
# Публичный HTTPS-адрес этого сервиса на Railway (он же URL Mini App)
WEBAPP_URL=
# Читать сообщения из чатов, куда добавлен бот
TG_LIVE_INGEST=true

# --- База данных ------------------------------------------------------------
# Railway подставляет DATABASE_URL автоматически при линковке Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comments

# --- ВКонтакте --------------------------------------------------------------
# Адаптер остаётся в коде и включается строкой ENABLED_NETWORKS=telegram,vk
# Токен пользователя с правами wall, groups (или сервисный токен сообщества)
VK_TOKEN=
VK_USER_TOKEN=
VK_API_VERSION=5.199

# --- Одноклассники ----------------------------------------------------------
OK_APP_KEY=
OK_APP_SECRET=
OK_ACCESS_TOKEN=
OK_ADAPTER_ENABLED=false

# --- Telegram-источники (MTProto) -------------------------------------------
# Необязательно: нужно только для выгрузки истории старых комментариев.
# Без этих переменных бот всё равно собирает новые сообщения из чатов.
# Создаётся скриптом: python scripts/tg_session.py
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# --- Instagram --------------------------------------------------------------
# Как и ВК/ОК, выключен в интерфейсе, но код адаптера на месте.
INSTAGRAM_ENABLED=false
IG_ACCESS_TOKEN=
IG_BUSINESS_ID=

# --- Проверка по рубрикам ---------------------------------------------------
RUBRICS_FILE=default.json
# Любой OpenAI-совместимый эндпоинт. Для Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_MIN_SCORE=0.45
ANALYZE_ON_INGEST=true

# --- Прочее -----------------------------------------------------------------
# Только для локальной отладки: отключает проверку initData
DEV_MODE=false
# web | worker — какой процесс запускать в контейнере
APP_ROLE=web
DEFAULT_CRAWL_INTERVAL_MINUTES=60
WORKER_POLL_SECONDS=20
